{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Y-app",
  "version": "0.32.0",
  "identifier": "foundation.openaec.y-app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Y-app",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "schemes": ["y-app"]
    },
    "updater": {
      "endpoints": [
        "https://github.com/OpenAEC-Foundation/Y-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGMkRBREQyN0Q5NzdFRkEKUldUNmZwZDkwcTB0ejFwZTlmNncwaml4bFRyZ05MR01NVTRRM1JpdE05WTh2ek5qK0pSb3U5UDEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
